<div class="page-header">
  <h1>Branch Menu Items</h1>
  <%= link_to "+ Add Item into Branch", new_branch_menu_item_path, class: "btn btn-primary" %>
</div>

<% if @branch_menu_items.any? %>
  <ul class="branch-list">
    <% @branch_menu_items.each do |bmi| %>
      <li>
        <%= link_to branch_menu_item_path(bmi) do %>
          <span class="list-primary"><%= bmi.menu_item.name %></span>
          <span class="list-secondary">at <%= bmi.branch.name %></span>
          <span class="list-meta">SAR <%= number_with_precision(bmi.menu_item_price, precision: 2) %></span>
          <% unless bmi.menu_item_availability %>
            <span class="badge badge-unavailable">Unavailable</span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <p>No branch menu items yet.</p>
    <%= link_to "Add your first link", new_branch_menu_item_path, class: "btn btn-primary" %>
  </div>
<% end %>
