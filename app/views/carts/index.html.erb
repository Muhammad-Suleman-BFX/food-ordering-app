<div class="page-header">
  <h1>Carts</h1>
  <%= link_to "+ New Cart", new_cart_path, class: "btn btn-primary" %>
</div>

<% if @carts.any? %>
  <ul class="branch-list">
    <% @carts.each do |cart| %>
      <li>
        <%= link_to cart_path(cart) do %>
          <span class="list-primary">Cart #<%= cart.id %></span>
          <span class="list-secondary"><%= cart.branch.name %></span>
          <span class="list-meta"><%= cart.cart_items.count %> items</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <p>No carts yet.</p>
    <%= link_to "Create a cart", new_cart_path, class: "btn btn-primary" %>
  </div>
<% end %>
