<% if @cart %>
  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <%= link_to "Change Branch", order_start_path, class: "btn btn-primary" %>
    <%= button_to "Delete Cart", @cart, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Delete this cart?" } %>
  </div>
  <% if @cart_items.present? %>
    <div style="margin: 20px 0;">
      <%= link_to "Continue Shopping", menu_branch_path(@cart.branch), class: "btn btn-secondary", style: "font-size: 16px; width: 100%; justify-content: center;" %>
    </div>
  <% end %>

  <div class="card">
    <h1>Cart #<%= @cart.id %></h1>

    <div class="detail-grid">
      <div class="detail-item">
        <label>Branch</label>
        <span><%= @cart.branch.name %></span>
      </div>
      <div class="detail-item">
        <label>Total Items</label>
        <span><%= @cart.cart_items.sum(:branch_menu_item_quantity) %></span>
      </div>
    </div>
  </div>

  <% if @cart_items.any? %>
    <h2 style="margin-top: 28px; margin-bottom: 16px;">Items</h2>
    <ul class="branch-list">
      <% @cart_items.each do |item| %>
        <li>
          <div style="padding: 16px 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
              <span class="list-primary" style="flex: 1;"><%= item.branch_menu_item.menu_item.name %></span>
              <%= button_to cart_item_path(item),
                  method: :delete,
                  class: "btn btn-danger",
                  style: "padding: 6px 12px; font-size: 12px;",
                  data: { turbo_confirm: "Remove this item?" } do %>
                ✕
              <% end %>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;">
              <%= form_with model: item, url: cart_item_path(item), method: :patch, local: true, style: "display: flex; align-items: center; gap: 8px;" do |f| %>
                <%= f.number_field :branch_menu_item_quantity, min: 1, value: item.branch_menu_item_quantity, style: "width: 60px; padding: 6px 10px; font-size: 14px;" %>
                <%= f.submit "Update", class: "btn btn-secondary", style: "padding: 6px 12px; font-size: 12px;" %>
              <% end %>
              <span class="list-meta">
                SAR <%= number_with_precision(item.branch_menu_item_quantity * item.branch_menu_item.menu_item_price, precision: 2) %>
              </span>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="card" style="margin-top: 24px; display: flex; align-items: center; justify-content: space-between;">
      <span style="font-size: 18px; font-weight: 700;">Total</span>
      <span style="font-size: 22px; font-weight: 700;">
        SAR <%= number_with_precision(@cart_items.sum { |i| i.branch_menu_item_quantity * i.branch_menu_item.menu_item_price }, precision: 2) %>
      </span>
    </div>

    <div style="margin-top: 20px;">
      <%= button_to place_order_path,
          method: :post,
          class: "btn btn-primary",
          style: "font-size: 16px; width: 100%; justify-content: center;",
          data: { turbo_confirm: "Place this order?" } do %>
        Place Order →
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>Your cart is empty.</p>
      <%= link_to "Continue Shopping", menu_branch_path(@cart.branch), class: "btn btn-primary" %>
    </div>
  <% end %>
<% else %>
  <div class="empty-state">
    <p>No active cart.</p>
    <%= link_to "Start an Order", order_start_path, class: "btn btn-primary" %>
  </div>
<% end %>
