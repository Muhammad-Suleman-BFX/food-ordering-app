<div class="page-header">
  <h1>Branches</h1>
  <%= link_to "+ New Branch", new_branch_path, class: "btn btn-primary" %>
</div>

<% if @branches.any? %>
  <ul class="branch-list">
    <% @branches.each do |branch| %>
      <li>
        <%= link_to branch.name, branch_path(branch) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <p>No branches yet.</p>
    <%= link_to "Add your first branch", new_branch_path, class: "btn btn-primary" %>
  </div>
<% end %>
