<div class="page-header">
  <%= link_to "← Back", branch_path(@branch), class: "btn btn-secondary" %>
  <%= link_to "+ Add Item into Branch", new_branch_branch_menu_item_path(@branch), class: "btn btn-primary" %>
</div>

<h1 style="margin-bottom: 8px;"><%= @branch.name %></h1>
<p style="color: #6b7280; margin-bottom: 24px;"><%= @branch.address %></p>

<% if @branch_menu_items.any? %>
  <ul class="menu-list">
    <% @branch_menu_items.each do |bmi| %>
      <li>
        <div style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
          <div style="flex: 1; min-width: 0;" class="<%= class_names("disable" => !bmi.is_available_at_branch?) %>">
            <span class="list-primary"><%= bmi.menu_item.name %></span>
            <% if bmi.menu_item.description.present? %>
              <span class="list-secondary" style="display: block; margin-top: 2px;"><%= bmi.menu_item.description %></span>
            <% end %>
            <span class="list-meta" style="margin-top: 4px;">SAR <%= number_with_precision(bmi.menu_item_price, precision: 2) %></span>
          </div>
          <%= link_to edit_branch_branch_menu_item_path(@branch, bmi),
              class: "btn btn-secondary",
              style: "white-space: nowrap; flex-shrink: 0;" do %>
            Edit
          <% end %>
          <%= button_to branch_branch_menu_item_path(@branch, bmi),
              method: :delete,
              class: "btn btn-danger",
              style: "white-space: nowrap; flex-shrink: 0;" do %>
            Delete
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <p>No items available at this branch right now.</p>
  </div>
<% end %>
