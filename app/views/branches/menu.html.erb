<div class="detail-actions page-header">
  <%= link_to "← Back", branch_path(@branch), class: "btn btn-secondary" %>
  <% if @branch_menu_items.any? %>
    <%= link_to "+ Add Item into Branch", new_branch_branch_menu_item_path(@branch), class: "btn btn-primary" %>
  <% end %>
</div>

<% if @branch_menu_items.any? %>
  <div class="detail-header">
    <h1>Branch Menu Items</h1>
  </div>
<% end %>

<% if @branch_menu_items.any? %>
  <ul class="menu-list">
    <% @branch_menu_items.each do |bmi| %>
      <div class="detail-grid">
        <div class="detail-item">
          <span>Item: <%= bmi.menu_item.name %></span>
          <label>Price: SAR <%= number_with_precision(bmi.menu_item_price, precision: 2) %></label>
          <label>Available: <%= bmi.menu_item_availability ? "Yes" : "No" %></label>
          <div class="menu-item-actions">
            <%= link_to "Edit", edit_branch_branch_menu_item_path(@branch, bmi), class: "btn btn-primary" %>
            <%= button_to "Delete", branch_branch_menu_item_path(@branch, bmi), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Delete this item from branch?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <p>No branch menu items yet.</p>
    <%= link_to "Add your first item", new_branch_branch_menu_item_path(@branch), class: "btn btn-primary" %>
  </div>
<% end %>