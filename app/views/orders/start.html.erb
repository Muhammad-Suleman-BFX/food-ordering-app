<div class="card" style="text-align: center; padding: 48px 28px;">
  <h1 style="margin-bottom: 8px;">Start Your Order</h1>
  <p style="color: #6b7280; margin-bottom: 32px;">Choose how you want to receive your order and pick a branch.</p>

  <%= form_with url: order_set_branch_path, method: :post, local: true do |form| %>
    <div class="form-group" style="text-align: left;">
      <%= form.label :order_type, "Order Type" %>
      <div style="display: flex; gap: 12px; margin-top: 8px;">
        <label class="radio-card <%= 'radio-card-selected' if params[:order_type] == 'pickup' || params[:order_type].nil? %>">
          <%= form.radio_button :order_type, "pickup", checked: params[:order_type] == 'pickup' || params[:order_type].nil? %>
          <span style="font-weight: 500;">🛍️ Pickup</span>
        </label>
        <label class="radio-card <%= 'radio-card-selected' if params[:order_type] == 'delivery' %>">
          <%= form.radio_button :order_type, "delivery", checked: params[:order_type] == 'delivery' %>
          <span style="font-weight: 500;">🚚 Delivery</span>
        </label>
      </div>
    </div>

    <div class="form-group" style="text-align: left;">
      <%= form.label :branch_id, "Select Branch" %>
      <%= form.collection_select :branch_id, @branches, :id, :name,
            { prompt: "Choose a branch...", selected: params[:branch_id] } %>
    </div>

    <div style="display: flex; align-items: center; gap: 12px; margin: 24px 0;">
      <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
      <span style="color: #9ca3af; font-size: 13px; font-weight: 500;">OR</span>
      <div style="flex: 1; height: 1px; background: #e5e7eb;"></div>
    </div>

    <p style="color: #6b7280; font-size: 14px; margin-bottom: 16px;">Enter GPS location to find nearest branch</p>

    <div class="detail-grid" style="text-align: left;">
      <div class="form-group" style="margin-bottom: 0;">
        <%= form.label :latitude %>
        <%= form.text_field :latitude, placeholder: "e.g. 21.543333", value: params[:latitude] %>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <%= form.label :longitude %>
        <%= form.text_field :longitude, placeholder: "e.g. 39.172778", value: params[:longitude] %>
      </div>
    </div>

    <div style="margin-top: 28px;">
      <%= form.submit "Browse Menu →", class: "btn btn-primary", style: "padding: 12px 32px; font-size: 15px;" %>
    </div>
  <% end %>
</div>
