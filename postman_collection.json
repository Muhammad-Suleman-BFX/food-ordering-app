    {
      "name": "🔄 Ordering Flow",
      "item": [
        {
          "name": "Step 1 — Start Order (Form)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/order/start",
              "host": ["{{base_url}}"],
              "path": ["order", "start"]
            },
            "description": "HTML form. Select order type and branch (or enter GPS coordinates)."
          }
        },
        {
          "name": "Step 2 — Set Branch & Type",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "order_type", "value": "pickup", "description": "pickup | delivery" },
                { "key": "branch_id", "value": "1", "description": "Branch ID (or leave blank with lat/lng)" },
                { "key": "latitude", "value": "", "description": "Optional: GPS latitude" },
                { "key": "longitude", "value": "", "description": "Optional: GPS longitude" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/order/set_branch",
              "host": ["{{base_url}}"],
              "path": ["order", "set_branch"]
            },
            "description": "Creates a cart and stores it in session. Redirects to branch menu."
          },
          "response": [
            {
              "name": "302 — Success",
              "status": "Found",
              "code": 302,
              "header": [{ "key": "Location", "value": "{{base_url}}/branches/1/menu" }],
              "body": ""
            },
            {
              "name": "422 — Validation fail (persisted)",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "<html>…form with alert banner + preserved inputs…</html>"
            }
          ]
        },
        {
          "name": "Step 3 — Place Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "session_id=abc123", "description": "Must include active session with cart_id" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/place",
              "host": ["{{base_url}}"],
              "path": ["orders", "place"]
            },
            "description": "Converts session cart to Order. Creates OrderItems with price snapshot. Clears cart session."
          },
          "response": [
            {
              "name": "302 — Order placed",
